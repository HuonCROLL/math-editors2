{
    "name": "@huoncroll/math-editors",
    "version": "1.0.39",
    "description": "MathLiveEditor, ExplanationEditor, and TiptapEditor with inline math - shared across Huons repos",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "import": "./dist/preview.mjs",
            "require": "./dist/preview.js"
        },
        "./chem-teaching-diagram": {
            "types": "./dist/chemTeachingDiagram.d.ts",
            "import": "./dist/chemTeachingDiagram.mjs",
            "require": "./dist/chemTeachingDiagram.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.mjs",
            "require": "./dist/vite.js"
        },
        "./dist/index.css": "./dist/index.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && node -e \"require('fs').copyFileSync('src/styles/tiptap.css','dist/index.css')\"",
        "dev": "tsup src/index.tsx --format cjs,esm --dts --watch"
    },
    "peerDependencies": {
        "@emotion/react": "^11.0.0",
        "@emotion/styled": "^11.0.0",
        "@mui/icons-material": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "@tiptap/core": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-mathematics": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-table": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-table-cell": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-table-header": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-table-row": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-text-align": "^2.0.0 || ^3.0.0",
        "@tiptap/extension-text-style": "^2.0.0 || ^3.0.0",
        "@tiptap/react": "^2.0.0 || ^3.0.0",
        "@tiptap/starter-kit": "^2.0.0 || ^3.0.0",
        "dompurify": "^3.0.0",
        "jsxgraph": "^1.10.1",
        "katex": "^0.16.0",
        "ketcher-core": "3.12.0",
        "ketcher-react": "3.12.0",
        "ketcher-standalone": "3.12.0",
        "mathlive": ">=0.100.0 <1.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "tiptap-extension-resize-image": "^1.0.0"
    },
    "dependencies": {
        "eve-raphael": "0.5.0",
        "raphael": "2.3.0"
    },
    "devDependencies": {
        "@types/katex": "^0.16.0",
        "@types/node": "^25.9.1",
        "@types/react": "^18.0.0 || ^19.0.0",
        "@types/react-dom": "^18.0.0 || ^19.0.0",
        "dompurify": "^3.2.6",
        "jsxgraph": "^1.10.1",
        "ketcher-core": "3.12.0",
        "ketcher-react": "3.12.0",
        "ketcher-standalone": "3.12.0",
        "tsup": "^8.0.0",
        "typescript": "^4.9.0 || ^5.0.0"
    }
}
